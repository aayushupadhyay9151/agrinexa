PORT=5000
NODE_ENV=development
JWT_SECRET=agrinexa_super_secret_jwt_key_2026_production_grade
DATABASE_PATH=./data/agrinexa.db

# Weather API Configuration
# By default, AgriNexa uses Open-Meteo (No API key required, live forecasts + ERA5 climate normals)
# You can also plug in an optional key for WeatherAPI or OpenWeatherMap:
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173
